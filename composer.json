{
    "name": "1994/ghostwriter-core",
    "description": "The framework-free core shared by the Ghostwriter addons for Statamic, Filament and Craft: draft text handling, prompts and the AI provider layer.",
    "type": "library",
    "license": "proprietary",
    "homepage": "https://github.com/1994limited/ghostwriter-core",
    "keywords": [
        "ai",
        "writing",
        "content",
        "ghostwriter"
    ],
    "authors": [
        {
            "name": "1994",
            "homepage": "https://1994.co.uk"
        }
    ],
    "support": {
        "issues": "https://github.com/1994limited/ghostwriter-core/issues",
        "source": "https://github.com/1994limited/ghostwriter-core"
    },
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "ext-dom": "*",
        "league/commonmark": "^2.4",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1|^2.0",
        "psr/log": "^1.1|^2.0|^3.0",
        "symfony/yaml": "^6.4|^7.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "laravel/pint": "^1.18",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Required to use Http\\GuzzleHttpClients, the ready-made HttpClients implementation."
    },
    "autoload": {
        "psr-4": {
            "NineteenNinetyFour\\Ghostwriter\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NineteenNinetyFour\\Ghostwriter\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "boundaries": "php bin/check-boundaries"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
