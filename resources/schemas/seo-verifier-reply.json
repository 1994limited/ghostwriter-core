{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/1994limited/ghostwriter-core/resources/schemas/seo-verifier-reply.json",
  "title": "Ghostwriter seo-verifier reply (structured output)",
  "description": "One verdict for every link shown. The id enum is filled for each call.",
  "type": "object",
  "required": ["verdicts"],
  "additionalProperties": false,
  "properties": {
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["notes", "id", "verdict", "reason"],
        "additionalProperties": false,
        "properties": {
          "notes": {"type": "string", "maxLength": 200, "description": "First, a few words for yourself on what you checked. Never shown to the editor."},
          "id": {"type": "string", "enum": ["l1"], "description": "The link (l1, l2…)."},
          "verdict": {"type": "string", "enum": ["keep", "drop"]},
          "reason": {"type": "string", "maxLength": 300, "description": "Why, briefly."}
        }
      }
    }
  }
}
