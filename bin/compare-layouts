#!/usr/bin/env php
<?php

/*
 * Compares two layout logs written by Layout\Testing\LayoutLog, e.g. an
 * addon's suite before and after it switched to core's layout algorithms.
 * Exits 1 when they differ.
 *
 *     bin/compare-layouts before.jsonl after.jsonl [--ignore=kinds,describe]
 */

use NineteenNinetyFour\Ghostwriter\Core\Layout\Testing\LayoutLog;

foreach ([dirname(__DIR__).'/vendor/autoload.php', dirname(__DIR__, 3).'/autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;

        break;
    }
}

$paths = array_values(array_filter(array_slice($argv, 1), fn (string $arg) => ! str_starts_with($arg, '--')));
$ignore = [];

foreach (array_slice($argv, 1) as $arg) {
    if (str_starts_with($arg, '--ignore=')) {
        $ignore = array_values(array_filter(explode(',', substr($arg, 9))));
    }
}

if (count($paths) !== 2) {
    fwrite(STDERR, "Usage: compare-layouts before.jsonl after.jsonl [--ignore=algorithm,algorithm]\n");

    exit(2);
}

try {
    $differences = LayoutLog::compare(LayoutLog::read($paths[0]), LayoutLog::read($paths[1]), $ignore);
} catch (RuntimeException $exception) {
    fwrite(STDERR, $exception->getMessage()."\n");

    exit(2);
}

foreach ($differences as $line) {
    echo $line, "\n";
}

echo $differences === [] ? "The layouts are the same.\n" : count($differences)." difference(s).\n";

exit($differences === [] ? 0 : 1);
